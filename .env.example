FLIGHT_CLUB_ADDR=:7080
FLIGHT_CLUB_LOG_LEVEL=info
FLIGHT_CLUB_LOG_FORMAT=text

OPENROUTER_API_KEY=
OPENROUTER_MODEL=z-ai/glm-5.3

AEROPLAN_EMAIL=
AEROPLAN_PASSWORD=
